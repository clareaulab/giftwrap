/*
 * nextflow.config — GIFTwrap pipeline configuration
 */

// Steps 2–5 modify the output directory in-place; copy staging prevents
// contaminating the upstream task's work directory.
process.stageInMode = 'copy'

process.container = '/data1/collab002/sail/projects/ongoing/tools/sail_giftwrap/sail_giftwrap/giftwrap-sc_0.4.1.sif'

singularity {
    enabled    = true
    autoMounts = true
}

params {
    technology         = "Flex"
    reads_per_gapfill  = 0
    umi_edit_distance  = 1
    allow_chimeras     = false
    max_pcr_thresholds = 10
    multiplex          = 1
    flatten            = false
}


profiles {

    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'cpu'

        process {
            withName: 'COUNT_GAPFILLS' {
                cpus   = 8
                memory = '32 GB'
                time   = '4h'
            }
            withName: 'CUTADAPT_PREPROCESS' {
                cpus   = 4
                memory = '8 GB'
                time   = '1h'
            }
            withName: 'CORRECT_UMIS|CORRECT_GAPFILLS|COLLECT_COUNTS|SUMMARIZE_COUNTS' {
                cpus   = 2
                memory = '8 GB'
                time   = '1h'
            }
        }
    }
}
